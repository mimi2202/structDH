{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(login|signup|forgot-password|dashboard|reports|organisations|structural-input|slab-results|continuous-slab|continuous-slab-results|beam|continuous-beam|beam-results|continuous-beam-results|column-input|column-results|foundation-input|foundation-results|combined-input|combined-results|staircase-design|staircase-results|settings|profile|load-cases|materials|help|new-design|quick-design|saved-designs|external-design|sdh-agent)",
      "destination": "/app.html"
    },
    {
      "source": "/(reset-password|workspace|new-design)/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/workspace",
      "destination": "/app.html"
    }
  ]
}
